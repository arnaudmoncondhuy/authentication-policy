{#
    L'écran du code à six chiffres.

    Il se remplace en entier : un fichier du même nom dans `templates/bundles/` de l'application
    prend sa place, ou la clé `templates.totp` en nomme un autre.
#}
{% extends layout ?? '@AuthenticationPolicy/layout.html.twig' %}

{% block title %}{{ 'factor.totp'|trans({}, 'authentication_policy') }}{% endblock %}

{% block body %}
<div class="app-stack">
    <h1>{{ 'factor.totp'|trans({}, 'authentication_policy') }}</h1>

    {% if erreur %}
        <p class="app-alert" data-tone="danger" role="alert">{{ erreur }}</p>
    {% endif %}

    {% if pose %}
        <div class="app-card app-stack">
            <p>{{ 'Votre application d’authentification est en place. Elle produit un code toutes les 30 secondes.'|trans({}, 'authentication_policy') }}</p>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                <input type="hidden" name="geste" value="forget">
                <button type="submit" class="app-btn" data-tone="danger" data-variant="ghost"{{ autres_moyens == 0 ? ' disabled' : '' }}>
                    {{ 'Retirer ce moyen'|trans({}, 'authentication_policy') }}
                </button>
            </form>

            {% if autres_moyens == 0 %}
                <p class="app-field-hint">{{ 'C’est votre seul moyen : posez-en un autre avant de le retirer.'|trans({}, 'authentication_policy') }}</p>
            {% endif %}
        </div>

    {% elseif en_attente %}
        <div class="app-card app-stack">
            <p>{{ 'Photographiez ce code avec votre application d’authentification, puis recopiez le nombre qu’elle affiche.'|trans({}, 'authentication_policy') }}</p>

            {% if image %}
                <img src="{{ image }}" alt="{{ 'Le code à photographier'|trans({}, 'authentication_policy') }}" width="220" height="220">
            {% endif %}

            {% if secret %}
                {# De quoi s'en sortir sans appareil photo : le secret se recopie à la main. #}
                <p class="app-field-hint">
                    {{ 'Sans appareil photo, saisissez cette clé :'|trans({}, 'authentication_policy') }}
                    <code>{{ secret }}</code>
                </p>
            {% endif %}

            <form method="post" class="app-stack">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                <input type="hidden" name="geste" value="confirm">

                <div class="app-field">
                    <label class="app-field-label" for="code">{{ 'Le code affiché'|trans({}, 'authentication_policy') }}</label>
                    <input type="text" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" autofocus required>
                </div>

                <button type="submit" class="app-btn" data-tone="accent">
                    {{ 'Confirmer'|trans({}, 'authentication_policy') }}
                </button>
            </form>
        </div>

    {% else %}
        <div class="app-card app-stack">
            <p>{{ 'Une application sur votre téléphone produit un code qui change toutes les 30 secondes. Rien ne circule au moment de s’en servir.'|trans({}, 'authentication_policy') }}</p>

            <form method="post">
                <input type="hidden" name="_token" value="{{ csrf_token(csrf_token_id) }}">
                <input type="hidden" name="geste" value="start">
                <button type="submit" class="app-btn" data-tone="accent">
                    {{ 'Commencer'|trans({}, 'authentication_policy') }}
                </button>
            </form>
        </div>
    {% endif %}
</div>
{% endblock %}
