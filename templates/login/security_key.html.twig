{#
    L'étape de connexion par une clé de sécurité.

    La demande part d'elle-même au chargement : la page n'a aucun moyen de savoir si une clé est
    branchée, et une demande ouverte laisse l'appareil se manifester seul. Les boutons restent
    le repli quand le navigateur a proposé la mauvaise clé.
#}
{% extends layout ?? '@AuthenticationPolicy/login/layout.html.twig' %}

{% block title %}{{ 'factor.security_key'|trans({}, 'authentication_policy') }}{% endblock %}

{% block body %}
<div class="app-stack">
    <h1>{{ 'factor.security_key'|trans({}, 'authentication_policy') }}</h1>

    {% if authenticationError %}
        <p class="app-alert" data-tone="danger" role="alert">
            {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
        </p>
    {% endif %}

    <div class="app-card app-stack">
        <p>{{ 'Approchez ou branchez votre clé, ou confirmez sur cet appareil.'|trans({}, 'authentication_policy') }}</p>

        <form method="post" action="{{ checkPathUrl ?: path(checkPathRoute) }}"
              data-controller="authentication-policy-security-key"
              data-authentication-policy-security-key-options-value="{{ options }}"
              data-authentication-policy-security-key-mode-value="get"
              data-action="submit->authentication-policy-security-key#sign"
              data-security-key-unsupported="{{ 'Ce navigateur ne sait pas parler aux clés de sécurité.'|trans({}, 'authentication_policy') }}"
              data-security-key-refused="{{ 'La clé n’a pas répondu, ou la demande a été annulée.'|trans({}, 'authentication_policy') }}"
              class="app-stack">

            <p hidden data-authentication-policy-security-key-target="error" role="alert"></p>

            <input type="hidden" name="{{ authCodeParameterName }}" data-authentication-policy-security-key-target="answer">

            {% if isCsrfProtectionEnabled %}
                <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
            {% endif %}

            {# Une clé désignée est la seule façon d'en viser une précisément : avec plusieurs
               clés éligibles, c'est le navigateur qui choisit, et les indications ne sont qu'un
               conseil. #}
            {% for rang, cle in cles %}
                <button type="submit" class="app-btn" data-variant="ghost"
                        data-security-key-only="{{ rang }}" data-security-key-genre="{{ cle.kind.value }}">
                    {% include '@AuthenticationPolicy/_key_icon.html.twig' with {genre: cle.kind.value} only %}
                    {{ cle.label }}
                </button>
            {% endfor %}
        </form>
    </div>

    {% for autre in availableTwoFactorProviders|filter(provider => provider != twoFactorProvider) %}
        <a href="{{ path('authentication_policy_login', {preferProvider: autre}) }}">
            {{ ('factor.' ~ autre)|trans({}, 'authentication_policy') }}
        </a>
    {% endfor %}

    {% if sortie %}
        <form method="post" action="{{ sortie }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button type="submit" class="app-btn" data-variant="ghost" data-size="sm">
                {{ 'Me déconnecter'|trans({}, 'authentication_policy') }}
            </button>
        </form>
    {% endif %}
</div>
{% endblock %}
